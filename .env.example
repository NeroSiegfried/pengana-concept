# --- Frontend (build-time) endpoint overrides -------------------------------
# The forms POST to /api/enquiry by default (see src/content/company.js).
# Set these only if you want a form to target a different endpoint instead.

# Optional shared POST endpoint for every enquiry form.
VITE_FORM_ENDPOINT=

# Business-specific endpoints take priority over the shared fallback.
VITE_CONCEPT_FORM_ENDPOINT=
VITE_PROPERTIES_FORM_ENDPOINT=
VITE_TISHINO_FORM_ENDPOINT=
VITE_SUNAB_FORM_ENDPOINT=

# --- Enquiry backend (api/enquiry.js — Vercel serverless + Resend) ----------
# Server-side only; NOT exposed to the browser. Set these in Vercel →
# Project → Settings → Environment Variables (Production + Preview).

# Resend API key (https://resend.com → API Keys).
RESEND_API_KEY=

# Verified sender. The domain must be verified in Resend first.
ENQUIRY_FROM="Pengana Concept <enquiries@penganaconcept.com>"

# Per-business recipient inboxes (routing is by the form's business id).
ENQUIRY_TO_CONCEPT=
ENQUIRY_TO_PROPERTIES=
ENQUIRY_TO_TISHINO=
ENQUIRY_TO_SUNAB=

# Fallback inbox when a business-specific one is not set.
ENQUIRY_TO_DEFAULT=enquiries@penganaconcept.com
